  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Atividade"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#contribuiPara"/>
          <owl:hasValue rdf:resource="#PerderPeso"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#UsuarioComRestricaoArticular">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Usuario"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temCondicao"/>
          <owl:someValuesFrom rdf:resource="#ProblemaArticular"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#UsuarioComRestricaoCardiaca">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Usuario"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temCondicao"/>
          <owl:someValuesFrom rdf:resource="#ProblemaCardiovascular"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#UsuarioIniciante">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Usuario"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#nivelCondicionamento"/>
          <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">iniciante</owl:hasValue>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

