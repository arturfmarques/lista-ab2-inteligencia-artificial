<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/lista2/academico.owl"
         xmlns="http://example.org/lista2/academico.owl#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#">

<owl:Ontology rdf:about="http://example.org/lista2/academico.owl"/>

<owl:ObjectProperty rdf:about="#matriculadoEm">
  <rdfs:domain rdf:resource="#Aluno"/>
  <rdfs:range rdf:resource="#Disciplina"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ministra">
  <rdfs:domain rdf:resource="#Professor"/>
  <rdfs:range rdf:resource="#Disciplina"/>
  <owl:inverseOf rdf:resource="#ministradaPor"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ministradaPor">
  <rdfs:domain rdf:resource="#Disciplina"/>
  <rdfs:range rdf:resource="#Professor"/>
  <owl:inverseOf rdf:resource="#ministra"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#auxilia">
  <rdfs:domain rdf:resource="#Aluno"/>
  <rdfs:range rdf:resource="#Disciplina"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#orienta">
  <rdfs:range rdf:resource="#Aluno"/>
  <owl:inverseOf rdf:resource="#orientadoPor"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#orientadoPor">
  <owl:inverseOf rdf:resource="#orienta"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temPreRequisito">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="#Disciplina"/>
  <rdfs:range rdf:resource="#Disciplina"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#pertenceA">
  <rdfs:domain rdf:resource="#Disciplina"/>
  <rdfs:range rdf:resource="#AreaConhecimento"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temInteresseEm">
  <rdfs:domain rdf:resource="#Pessoa"/>
  <rdfs:range rdf:resource="#AreaConhecimento"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#cursa">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Aluno"/>
  <rdfs:range rdf:resource="#Curso"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#pesquisaEm">
  <rdfs:range rdf:resource="#AreaConhecimento"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#ministra"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#pertenceA"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#deveCursarAntes">
  <rdfs:domain rdf:resource="#Aluno"/>
  <rdfs:range rdf:resource="#Disciplina"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#cargaHoraria">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Disciplina"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#nome">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Pessoa">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Aluno">
  <rdfs:subClassOf rdf:resource="#Pessoa"/>
  <owl:disjointWith rdf:resource="#Professor"/>
</owl:Class>

<owl:Class rdf:about="#AlunoGraduacao">
  <rdfs:subClassOf rdf:resource="#Aluno"/>
</owl:Class>

<owl:Class rdf:about="#AlunoPosGraduacao">
  <rdfs:subClassOf rdf:resource="#Aluno"/>
</owl:Class>

<owl:Class rdf:about="#Professor">
  <rdfs:subClassOf rdf:resource="#Pessoa"/>
</owl:Class>

<owl:Class rdf:about="#Disciplina">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Curso">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#AreaConhecimento">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Monitor">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Aluno"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#auxilia"/>
          <owl:someValuesFrom rdf:resource="#Disciplina"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Aluno"/>
</owl:Class>

<owl:Class rdf:about="#Orientador">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Professor"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#orienta"/>
          <owl:someValuesFrom rdf:resource="#Aluno"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Professor"/>
</owl:Class>

<owl:Class rdf:about="#DisciplinaAvancada">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Disciplina"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temPreRequisito"/>
          <owl:someValuesFrom rdf:resource="#Disciplina"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Disciplina"/>
</owl:Class>

<owl:Class rdf:about="#DisciplinaDeIA">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Disciplina"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#pertenceA"/>
          <owl:hasValue rdf:resource="#InteligenciaArtificial"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Disciplina"/>
</owl:Class>

<owl:Class rdf:about="#DocenteDeIA">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Professor"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#ministra"/>
          <owl:someValuesFrom rdf:resource="#DisciplinaDeIA"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Professor"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#InteligenciaArtificial">
  <rdf:type rdf:resource="#AreaConhecimento"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#FundamentosDaComputacao">
  <rdf:type rdf:resource="#AreaConhecimento"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#CienciaDaComputacao">
  <rdf:type rdf:resource="#Curso"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Programacao">
  <rdf:type rdf:resource="#Disciplina"/>
  <pertenceA rdf:resource="#FundamentosDaComputacao"/>
  <cargaHoraria rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">60</cargaHoraria>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Algoritmos">
  <rdf:type rdf:resource="#Disciplina"/>
  <temPreRequisito rdf:resource="#Programacao"/>
  <pertenceA rdf:resource="#FundamentosDaComputacao"/>
  <rdf:type rdf:resource="#DisciplinaAvancada"/>
  <cargaHoraria rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">60</cargaHoraria>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#IA">
  <rdf:type rdf:resource="#Disciplina"/>
  <temPreRequisito rdf:resource="#Algoritmos"/>
  <pertenceA rdf:resource="#InteligenciaArtificial"/>
  <rdf:type rdf:resource="#DisciplinaDeIA"/>
  <rdf:type rdf:resource="#DisciplinaAvancada"/>
  <temPreRequisito rdf:resource="#Programacao"/>
  <cargaHoraria rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">60</cargaHoraria>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#AprendizadoDeMaquina">
  <rdf:type rdf:resource="#Disciplina"/>
  <temPreRequisito rdf:resource="#IA"/>
  <pertenceA rdf:resource="#InteligenciaArtificial"/>
  <rdf:type rdf:resource="#DisciplinaDeIA"/>
  <rdf:type rdf:resource="#DisciplinaAvancada"/>
  <temPreRequisito rdf:resource="#Algoritmos"/>
  <temPreRequisito rdf:resource="#Programacao"/>
  <cargaHoraria rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">60</cargaHoraria>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ProfEvandro">
  <rdf:type rdf:resource="#Professor"/>
  <ministra rdf:resource="#IA"/>
  <ministra rdf:resource="#AprendizadoDeMaquina"/>
  <rdf:type rdf:resource="#DocenteDeIA"/>
  <rdf:type rdf:resource="#Orientador"/>
  <pesquisaEm rdf:resource="#InteligenciaArtificial"/>
  <nome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Evandro Costa</nome>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ProfMarta">
  <rdf:type rdf:resource="#Pessoa"/>
  <ministra rdf:resource="#Programacao"/>
  <rdf:type rdf:resource="#Professor"/>
  <pesquisaEm rdf:resource="#FundamentosDaComputacao"/>
  <nome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Marta</nome>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Ana">
  <rdf:type rdf:resource="#Aluno"/>
  <cursa rdf:resource="#CienciaDaComputacao"/>
  <matriculadoEm rdf:resource="#AprendizadoDeMaquina"/>
  <deveCursarAntes rdf:resource="#IA"/>
  <deveCursarAntes rdf:resource="#Algoritmos"/>
  <deveCursarAntes rdf:resource="#Programacao"/>
  <nome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ana</nome>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Bruno">
  <rdf:type rdf:resource="#AlunoGraduacao"/>
  <cursa rdf:resource="#CienciaDaComputacao"/>
  <matriculadoEm rdf:resource="#IA"/>
  <auxilia rdf:resource="#Algoritmos"/>
  <rdf:type rdf:resource="#Monitor"/>
  <deveCursarAntes rdf:resource="#Algoritmos"/>
  <deveCursarAntes rdf:resource="#Programacao"/>
  <nome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bruno</nome>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Carla">
  <rdf:type rdf:resource="#AlunoPosGraduacao"/>
  <orientadoPor rdf:resource="#ProfEvandro"/>
  <temInteresseEm rdf:resource="#InteligenciaArtificial"/>
  <nome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carla</nome>
</owl:NamedIndividual>

<swrl:Variable rdf:about="urn:swrl#a"/>

<swrl:Variable rdf:about="urn:swrl#d"/>

<swrl:Variable rdf:about="urn:swrl#p"/>

<swrl:Imp>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#deveCursarAntes"/>
          <swrl:argument1 rdf:resource="urn:swrl#a"/>
          <swrl:argument2 rdf:resource="urn:swrl#d"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="#temPreRequisito"/>
              <swrl:argument1 rdf:resource="urn:swrl#d"/>
              <swrl:argument2 rdf:resource="urn:swrl#p"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#deveCursarAntes"/>
          <swrl:argument1 rdf:resource="urn:swrl#a"/>
          <swrl:argument2 rdf:resource="urn:swrl#p"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
</swrl:Imp>

<swrl:Imp>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#Aluno"/>
          <swrl:argument1 rdf:resource="urn:swrl#a"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="#matriculadoEm"/>
              <swrl:argument1 rdf:resource="urn:swrl#a"/>
              <swrl:argument2 rdf:resource="urn:swrl#d"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:IndividualPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="#temPreRequisito"/>
                  <swrl:argument1 rdf:resource="urn:swrl#d"/>
                  <swrl:argument2 rdf:resource="urn:swrl#p"/>
                </swrl:IndividualPropertyAtom>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#deveCursarAntes"/>
          <swrl:argument1 rdf:resource="urn:swrl#a"/>
          <swrl:argument2 rdf:resource="urn:swrl#p"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
</swrl:Imp>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#Pessoa"/>
    <rdf:Description rdf:about="#Disciplina"/>
    <rdf:Description rdf:about="#Curso"/>
    <rdf:Description rdf:about="#AreaConhecimento"/>
  </owl:members>
</owl:AllDisjointClasses>


</rdf:RDF>
