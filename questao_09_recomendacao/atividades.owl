<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/lista2/atividades.owl"
         xmlns="http://example.org/lista2/atividades.owl#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#">

<owl:Ontology rdf:about="http://example.org/lista2/atividades.owl"/>

<owl:ObjectProperty rdf:about="#contribuiPara">
  <rdfs:domain rdf:resource="#Atividade"/>
  <rdfs:range rdf:resource="#Objetivo"/>
  <owl:inverseOf rdf:resource="#eAtingidoPor"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#eAtingidoPor">
  <owl:inverseOf rdf:resource="#contribuiPara"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#realizadaEm">
  <rdfs:domain rdf:resource="#Atividade"/>
  <rdfs:range rdf:resource="#Local"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#requer">
  <rdfs:domain rdf:resource="#Atividade"/>
  <rdfs:range rdf:resource="#Equipamento"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temIntensidade">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Atividade"/>
  <rdfs:range rdf:resource="#NivelIntensidade"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#contraindicadaPara">
  <rdfs:domain rdf:resource="#Atividade"/>
  <rdfs:range rdf:resource="#CondicaoSaude"/>
  <owl:inverseOf rdf:resource="#desaconselha"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#desaconselha">
  <owl:inverseOf rdf:resource="#contraindicadaPara"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#similarA">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:domain rdf:resource="#Atividade"/>
  <rdfs:range rdf:resource="#Atividade"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temObjetivo">
  <rdfs:domain rdf:resource="#Usuario"/>
  <rdfs:range rdf:resource="#Objetivo"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temCondicao">
  <rdfs:domain rdf:resource="#Usuario"/>
  <rdfs:range rdf:resource="#CondicaoSaude"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temAcessoA">
  <rdfs:domain rdf:resource="#Usuario"/>
  <rdfs:range rdf:resource="#Local"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#possui">
  <rdfs:domain rdf:resource="#Usuario"/>
  <rdfs:range rdf:resource="#Equipamento"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#atividadeCandidata">
  <rdfs:domain rdf:resource="#Usuario"/>
  <rdfs:range rdf:resource="#Atividade"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#temObjetivo"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#eAtingidoPor"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#deveEvitar">
  <rdfs:domain rdf:resource="#Usuario"/>
  <rdfs:range rdf:resource="#Atividade"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#temCondicao"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#desaconselha"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#impactoArticular">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Atividade"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#requerEquipamento">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Atividade"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#gastoCaloricoHora">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Atividade"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#duracaoSugerida">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Atividade"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#nivelCondicionamento">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Usuario"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#idade">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Usuario"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#nome">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Atividade">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#AtividadeAerobica">
  <rdfs:subClassOf rdf:resource="#Atividade"/>
</owl:Class>

<owl:Class rdf:about="#AtividadeAquatica">
  <rdfs:subClassOf rdf:resource="#AtividadeAerobica"/>
</owl:Class>

<owl:Class rdf:about="#AtividadeForca">
  <rdfs:subClassOf rdf:resource="#Atividade"/>
</owl:Class>

<owl:Class rdf:about="#AtividadeFlexibilidade">
  <rdfs:subClassOf rdf:resource="#Atividade"/>
</owl:Class>

<owl:Class rdf:about="#AtividadeMenteCorpo">
  <rdfs:subClassOf rdf:resource="#AtividadeFlexibilidade"/>
</owl:Class>

<owl:Class rdf:about="#Usuario">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Objetivo">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Local">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Equipamento">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#NivelIntensidade">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#CondicaoSaude">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#ProblemaArticular">
  <rdfs:subClassOf rdf:resource="#CondicaoSaude"/>
</owl:Class>

<owl:Class rdf:about="#ProblemaCardiovascular">
  <rdfs:subClassOf rdf:resource="#CondicaoSaude"/>
</owl:Class>

<owl:Class rdf:about="#ProblemaRespiratorio">
  <rdfs:subClassOf rdf:resource="#CondicaoSaude"/>
</owl:Class>

<owl:Class rdf:about="#AtividadeBaixoImpacto">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Atividade"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#impactoArticular"/>
          <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">baixo</owl:hasValue>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <owl:disjointWith rdf:resource="#AtividadeAltoImpacto"/>
</owl:Class>

<owl:Class rdf:about="#AtividadeAltoImpacto">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Atividade"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#impactoArticular"/>
          <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">alto</owl:hasValue>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#AtividadeSemEquipamento">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Atividade"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#requerEquipamento"/>
          <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</owl:hasValue>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#AtividadeEmCasa">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Atividade"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#realizadaEm"/>
          <owl:hasValue rdf:resource="#Casa"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#AtividadeVigorosa">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Atividade"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temIntensidade"/>
          <owl:hasValue rdf:resource="#Vigorosa"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#AtividadeParaEmagrecer">
